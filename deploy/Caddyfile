# Caddy config for serving the tada web app (and, for now, the push probe) from
# this Mac to other devices on the LAN.
#
# Start it as your own user, NOT with sudo:
#
#   nix run nixpkgs#caddy -- run --config deploy/Caddyfile
#
# Running as your user matters. Caddy's internal CA root lives in that user's
# data dir (~/Library/Application Support/Caddy/pki/authorities/local). That is
# the root already installed and trusted on the iPhone, so reusing it keeps
# every cert below trusted. `sudo caddy` would use a different data dir, mint a
# fresh root, and every device would show a certificate warning.
#
# Ports are 8443/8444 rather than 443 because macOS reserves ports below 1024
# for root, and running Caddy as root would break the CA trust described above.
#
# The site addresses are a bare IP on purpose: this host has no DNS name. Caddy
# issues an IP-SAN cert from the internal CA, which is enough for browsers to
# treat the origin as a secure context — the prerequisite for service workers,
# installable PWAs and web push.
{
	# The admin endpoint stays on (default 127.0.0.1:2019, loopback only) so
	# `caddy reload --config deploy/Caddyfile` can apply changes without dropping
	# connections. Turning it off makes reload impossible and forces a restart.

	# Without this Caddy also binds :80 to serve HTTP->HTTPS redirects, which
	# needs root on macOS and would defeat the run-as-your-user requirement
	# above. Every site here is reached over https on an explicit port anyway.
	auto_https disable_redirects
}

# --- the tada web app, and the API under /api -------------------------------
# Build the bundle first:
#   pnpm --filter @tada/mobile exec expo export --platform web
#
# The API is proxied under /api on this SAME origin, which is the point of this
# block. Serving the API from a second port made it a separate origin, and on a
# host with no publicly trusted certificate that costs real usability: Safari
# demands the certificate be accepted once per origin, so a phone that happily
# loaded the app still refused every API call until the user manually visited
# the API port and accepted it there too. Same origin means one acceptance, no
# CORS preflights, and no second port to explain.
#
# Point the app's connection screen at https://<host>:8443/api
https://{$TADA_HOST:192.168.1.91}:8443 {
	tls internal

	# handle_path strips the /api prefix before proxying, so the server keeps
	# seeing the paths it actually registers (/health, /settings, /ws...) and
	# needs no knowledge of where it is mounted. This must come before the
	# static handler or the SPA fallback below would swallow every API call.
	#
	# Websockets ride the same door: the client derives wss:// from https:// and
	# appends /ws to the same base URL, so it arrives here as /api/ws and is
	# upgraded by reverse_proxy automatically.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:4242
	}

	handle {
		root * /Users/djcopley/Developer/tada/apps/mobile/dist
		encode gzip

		# expo-router exports with web.output "static": every route is prerendered
		# to its own .html file (/settings -> settings.html). Try the literal path,
		# then that .html file, then fall back to index.html so client-side-only
		# routes and deep links still boot the app instead of 404ing.
		try_files {path} {path}.html /index.html
		file_server

		# A service worker is scoped to the directory it is served from, so it has
		# to sit at the site root to control the whole app. It must also never be
		# cached, or a deploy can leave clients pinned to an old worker.
		header /sw.js Cache-Control "no-store"
		header /manifest.json Content-Type "application/manifest+json"

		# The prerendered shells carry no cache header of their own, so Safari was
		# free to reuse them without revalidating — and an installed PWA does. The
		# JS filename inside the shell is content-hashed, so a stale shell pins the
		# app to a stale bundle: a deploy lands, the page is reloaded, and nothing
		# changes. Cost of no-store here is one 42KB request per launch; the bundle
		# it points at is immutable and still cached.
		@shell not path /_expo/* /sw.js /manifest.json /favicon.ico
		header @shell Cache-Control "no-store"
		header /_expo/* Cache-Control "public, max-age=31536000, immutable"
	}
}

# --- the tada API on its own port (legacy) ----------------------------------
# Superseded by /api on 8443 above, and kept only for clients that are not a
# browser and so have neither the mixed-content rule nor the per-origin
# certificate prompt to worry about. Browsers should use /api.
# A TLS front door for the server, which itself speaks plain HTTP on 4242.
#
# This is not optional once the app is served over HTTPS: browsers block an
# HTTPS page from talking to an http:// origin as mixed content, and they do it
# at the network layer with no useful error — the client just reports "could not
# reach server", which looks exactly like the server being down.
#
# Websockets ride through the same door. The client derives wss:// from https://
# (see client.ts#wsUrl), and reverse_proxy handles the upgrade automatically, so
# /ws needs no special handling here.
#
# The server keeps binding 127.0.0.1 only as far as this proxy is concerned; the
# MCP callback URL handed to agents stays loopback regardless.
https://{$TADA_HOST:192.168.1.91}:8444 {
	tls internal
	reverse_proxy 127.0.0.1:4242
}
