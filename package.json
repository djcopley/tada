{
  "name": "tada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "pnpm --filter @tada/mobile exec expo export --platform web",
    "deploy": "bash deploy/deploy.sh",
    "deploy:install": "bash deploy/install.sh",
    "lint": "biome check . && pnpm --filter @tada/mobile lint",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @tada/server start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
